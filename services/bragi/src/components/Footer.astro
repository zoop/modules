---
import Logo from "./Logo.astro";
import en from "@/content/en-US.json";
const { footer } = en;
---

<footer class="border-t border-hair bg-surface">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-4 text-sm leading-relaxed text-muted">{footer.tagline}</p>
      </div>
      {
        footer.columns.map((col) => (
          <div>
            <h3 class="font-display text-xs font-semibold uppercase tracking-wider text-muted">{col.title}</h3>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-ink/80 transition-colors hover:text-primary">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-hair pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>{footer.copyright}</p>
      <p class="max-w-md sm:text-right">{footer.note}</p>
    </div>
  </div>
</footer>
